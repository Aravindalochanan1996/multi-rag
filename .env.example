# LLM provider: ollama (local, private) | anthropic | groq (hosted, fast; prompts are sent to the API)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://127.0.0.1:11434
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings (local via Ollama)
EMBED_MODEL=nomic-embed-text

DATABASE_URL=postgresql://app:app@localhost:5435/career
MAX_UPLOAD_MB=5
LOG_LEVEL=INFO
